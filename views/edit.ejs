<%- include ('encabezado.ejs') %>

    <form action="/editar" method="post">
        <div class="card mx-auto" style="width: 25rem;">

            <div class="card-body">
                <input type="hidden" name="id" value="<%= fila[0].id %>">
                <label>Nombre de producto</label>
                <input type="text" name="nombre" class="form-control" required minlength="4" maxlength="30"
                    value="<%= fila[0].nombre %>">

                <label>Marca</label>
                <% function etiqueta(valor) { if (valor==fila[0].marca) { return 'selected' }return '' } %>

                    <select class="form-select" name="marca">
                        <% for (let fila of marcas) {%>
                        
                            <option value="<%= fila.id %>" <%=etiqueta(fila.id) %>><%= fila.marca %></option>

                        <% } %>
                                
                    </select>

                    <label>Precio</label>
                    <input type="number" name="precio" required min="-1" max="999" class="form-control"
                        value="<%= fila[0].precio %>">

                    <label>Stock</label>
                    <input type="number" name="stock" required min="-1" class="form-control"
                        value="<%= fila[0].stock %>">

            </div>
            <div class="card-footer">
                <button type="reset" class="btn btn-secondary">Restablecer</button>
                <button type="submit" class="btn btn-primary">Modificar</button>
            </div>

        </div>
    </form>

    </body>

    </html>
    <%- include ('pie_pagina.ejs') %>