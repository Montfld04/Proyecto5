<%- include ('encabezado.ejs') %>

    <!--boton nueva marca-->
    <div class="container-fluid p-4">
        <div class="mt-5 mb-2">
            <a href="#" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ventana_nueva_marca"> <img
                    src="/imagenes/nuevoBlanco.png"> Nueva marca </a>
            <!--<input type="button" value="Nuevo Producto" class="btn btn-primary">-->
        </div>
        <!-- fin de boton nueva marca-->

        <!--tabla de marcas-->
        <div>
            <div class="card">
                <div class="card-body">
                    <table border="1" class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Marca del producto</th>
                                <th scope="col" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% let i=1; for (let fila of filas) { %>
                                <tr class="align-middle">
                                    <th scope="row">
                                        <%= i++ %>
                                    </th>
                                    <td>
                                        <%= fila.marca %>
                                    </td>
                                    <td class="text-center">
                                        <a href="/edit_marcas?id=<%= fila.id %>" class="btn btn-success"> <img
                                                src="imagenes/check.png"></a>
                                        <a href="/eliminar_marca?id=<%= fila.id %>"
                                            onclick="return confirm('¿esta seguro de eliminar?')"
                                            class="btn btn-danger"><img src="imagenes/delete.png"></a>
                                        <!--con signo de interrogacion indicamos que es un valor que selecciona-->
                                    </td>
                                </tr>
                                <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!--fin de la tabla de marcas-->

        <!--ventana de nueva marca-->
        <form action="/nueva_marca" method="post">
            <div class="modal fade" id="ventana_nueva_marca" data-bs-backdrop="static" data-bs-keyboard="false"
                tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5" id="staticBackdropLabel">Agregar nuevo producto</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">

                            <label>Nombre de la marca</label>
                            <input type="text" name="marca" class="form-control" required minlength="4" maxlength="30"
                                placeholder="Nombre de la marca nueva">

                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Agregar</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
            <!--fin de ventana de nuevo producto-->
    </div>
    <%- include ('pie_pagina.ejs') %>